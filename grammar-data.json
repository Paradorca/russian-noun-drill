  "caseUsages": {
    "nominative": {
      "name": "主格",
      "meaning": "行为的主体，表示'谁'或'什么'做了某事",
      "usage": "回答 кто?（谁？）或 что?（什么？）的问题。作主语、谓语（表示等同关系）。",
      "prepositions": [],
      "example": "Книга лежит на столе.（书在桌上。）"
    },
    "genitive": {
      "name": "属格",
      "meaning": "表示所属、数量、否定、部分等关系",
      "usage": "回答 кого?（谁的？）或 чего?（什么的？）的问题。表示所属、数量（много/мало/нет + 二格）、否定、时间等。",
      "prepositions": [
        "без",
        "до",
        "для",
        "из",
        "от",
        "у",
        "около",
        "возле",
        "внутри",
        "вне",
        "после",
        "кроме",
        "вместо",
        "вдоль",
        "по",
        "с",
        "со"
      ],
      "example": "У меня нет книги.（我没有书。）"
    },
    "dative": {
      "name": "与格",
      "meaning": "行为的间接对象，表示'给谁'、'向谁'",
      "usage": "回答 кому?（给谁？）或 чему?（给什么？）的问题。表示给予、年龄、方向（向某处运动）等。",
      "prepositions": [
        "к",
        "ко",
        "по",
        "благодаря",
        "вопреки",
        "согласно"
      ],
      "example": "Я помогаю другу.（我帮助朋友。）"
    },
    "accusative": {
      "name": "宾格",
      "meaning": "行为的直接对象，表示'谁'或'什么'被作用",
      "usage": "回答 кого?（把谁？）或 что?（把什么？）的问题。表示直接宾语、时间、方向（向某处运动，与 в/на 连用）等。",
      "prepositions": [
        "в",
        "во",
        "на",
        "за",
        "через",
        "про",
        "о",
        "об"
      ],
      "example": "Я читаю книгу.（我在读书。）"
    },
    "instrumental": {
      "name": "工具格",
      "meaning": "表示工具、方式、伴随等",
      "usage": "回答 кем?（用谁？/和谁？）或 чем?（用什么？）的问题。表示工具、方式、伴随（с + 五格）、时间、地点等。",
      "prepositions": [
        "с",
        "со",
        "под",
        "над",
        "перед",
        "между",
        "за"
      ],
      "example": "Я пишу ручкой.（我用钢笔写字。）"
    },
    "prepositional": {
      "name": "前置格",
      "meaning": "表示地点、话题、时间等",
      "usage": "回答 о ком?（关于谁？）或 о чём?（关于什么？）的问题。必须与前置词连用，表示地点（в/на + 六格）、话题等。",
      "prepositions": [
        "в",
        "во",
        "на",
        "о",
        "об",
        "при"
      ],
      "example": "Мы говорим о книге.（我们在谈论书。）"
    }
  }
}
